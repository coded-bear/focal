{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint *)",
      "Bash(pnpm lint)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm build)",
      "Bash(pnpm exec prettier *)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec tsc *)",
      "Bash(playwright-cli *)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    }
  },
  "enabledPlugins": {
    "impeccable@impeccable": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && { git diff --name-only --diff-filter=ACMR -z HEAD; git ls-files --others --exclude-standard -z; } | xargs -0 pnpm exec prettier --write --ignore-unknown --log-level warn 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "Formatting with Prettier..."
          }
        ]
      }
    ]
  }
}
